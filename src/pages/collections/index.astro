---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageShell from '@/components/layout/PageShell.astro';
import PageVisualHero from '@/components/feature/PageVisualHero.astro';
import ChapterMascot from '@/components/feature/ChapterMascot.astro';
import ObservationCard from '@/components/feature/ObservationCard.astro';
import MascotTheater from '@/components/feature/MascotTheater.astro';
import ArchiveFrame from '@/components/ui/ArchiveFrame.astro';
import { observations, observationKinds } from '@/data/observations';

const grouped = observations.map((item) => ({
  ...item,
  kindLabel: observationKinds[item.kind]
}));
---

<BaseLayout title="观测收藏 | 未来观测站" description="番剧、游戏、音乐与日常灵感的个人收藏索引。">
  <PageShell>
    <PageVisualHero
      title="观测收藏"
      subtitle="整理忆丶未来的番剧观测、游戏存档、音乐循环和日常灵感，作为站点里的个人收藏区。"
      image="/assets/hero-about.png"
      alt="未来观测站收藏室和看板娘"
    />

    <div class="collection-layout">
      <main>
        <ChapterMascot
          chapter="收藏"
          title="二次元观测清单"
          subtitle="用轻量卡片归纳不同类型的兴趣记录，为更完整的收藏档案保留结构。"
          variant="home"
        />
        <div class="collection-grid">
          {grouped.map((item) => <ObservationCard item={item} />)}
        </div>
      </main>

      <aside class="collection-side">
        <ArchiveFrame label="维护方式">
          <h2>内容维护</h2>
          <p>观测卡片统一维护在 `src/data/observations.ts`，首页和收藏页共用同一份数据。</p>
        </ArchiveFrame>
        <ArchiveFrame label="分类索引">
          <h2>观测分类</h2>
          <div class="kind-list">
            {grouped.map((item) => <span>{item.kindLabel}</span>)}
          </div>
        </ArchiveFrame>
        <MascotTheater />
      </aside>
    </div>
  </PageShell>
</BaseLayout>

<style>
  .collection-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 21rem);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .collection-side {
    display: grid;
    gap: 1rem;
  }

  .collection-side h2 {
    margin: 0 0 0.65rem;
    color: var(--color-text);
    font-size: 1.12rem;
  }

  .collection-side p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .kind-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kind-list span {
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 999px;
    padding: 0.28rem 0.58rem;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 800;
  }

  @media (max-width: 980px) {
    .collection-layout {
      grid-template-columns: 1fr;
    }

    .collection-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .collection-grid,
    .collection-side {
      grid-template-columns: 1fr;
    }
  }
</style>
