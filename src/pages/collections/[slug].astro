---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageShell from '@/components/layout/PageShell.astro';
import ArchiveFrame from '@/components/ui/ArchiveFrame.astro';
import { observationKinds } from '@/data/observations';
import {
  formatDateLong,
  formatRating,
  getEntrySlug,
  getObservationHref,
  sortObservationsByDateDesc
} from '@/lib/content';

interface Props {
  item: CollectionEntry<'observations'>;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
  siblings: { title: string; href: string; rating?: number }[];
}

export async function getStaticPaths() {
  const all = sortObservationsByDateDesc(
    await getCollection('observations', ({ data }) => !data.draft)
  );

  return all.map((item, index) => ({
    params: { slug: getEntrySlug(item.id) },
    props: {
      item,
      prev: all[index - 1] && {
        title: all[index - 1].data.title,
        href: getObservationHref(all[index - 1])
      },
      next: all[index + 1] && {
        title: all[index + 1].data.title,
        href: getObservationHref(all[index + 1])
      },
      siblings: all
        .filter((other) => other.data.kind === item.data.kind && other.id !== item.id)
        .slice(0, 5)
        .map((other) => ({
          title: other.data.title,
          href: getObservationHref(other),
          rating: other.data.rating
        }))
    }
  }));
}

const { item, prev, next, siblings } = Astro.props;
const { Content } = await item.render();
const meta = observationKinds[item.data.kind];
const statusText = meta.statusLabels[item.data.status];
const ratingText = formatRating(item.data.rating);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': item.data.kind === 'music' ? 'MusicRecording' : 'CreativeWork',
  name: item.data.title,
  description: item.data.summary,
  dateCreated: item.data.date.toISOString(),
  inLanguage: 'zh-CN',
  ...(item.data.rating !== undefined
    ? {
        review: {
          '@type': 'Review',
          reviewRating: {
            '@type': 'Rating',
            ratingValue: item.data.rating,
            bestRating: 10,
            worstRating: 0
          }
        }
      }
    : {})
};
---

<BaseLayout
  title={`${item.data.title} | 观测收藏`}
  description={item.data.summary}
  type="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <PageShell narrow>
    <article class:list={['observation-detail', `accent-${meta.accent}`]}>
      <header>
        <div class="meta-row">
          <a class="back" href="/collections/">← 观测收藏</a>
          <span class="kind">{meta.label}</span>
        </div>
        <h1>{item.data.title}</h1>
        <p class="lede">{item.data.summary}</p>

        <dl class="facts">
          <div>
            <dt>状态</dt>
            <dd class:list={['status', `status-${item.data.status}`]}>{statusText}</dd>
          </div>
          {ratingText && (
            <div>
              <dt>评分</dt>
              <dd class="rating">
                <em>{ratingText}</em><span>/ 10</span>
              </dd>
            </div>
          )}
          <div>
            <dt>开始</dt>
            <dd><time datetime={item.data.date.toISOString()}>{formatDateLong(item.data.date)}</time></dd>
          </div>
          {item.data.finishedDate && (
            <div>
              <dt>{meta.finishedLabel}</dt>
              <dd>
                <time datetime={item.data.finishedDate.toISOString()}>
                  {formatDateLong(item.data.finishedDate)}
                </time>
              </dd>
            </div>
          )}
          {item.data.link && (
            <div>
              <dt>原站</dt>
              <dd>
                <a class="ext" href={item.data.link} rel="noopener noreferrer" target="_blank">
                  {item.data.linkLabel} ↗
                </a>
              </dd>
            </div>
          )}
        </dl>
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        siblings.length > 0 && (
          <ArchiveFrame label={`同类观测 · ${meta.label}`}>
            <ul class="siblings">
              {siblings.map((other) => (
                <li>
                  <a href={other.href}>{other.title}</a>
                  {other.rating !== undefined && <span>{formatRating(other.rating)}</span>}
                </li>
              ))}
            </ul>
          </ArchiveFrame>
        )
      }

      {
        (prev || next) && (
          <nav class="detail-nav" aria-label="相邻观测">
            {prev && (
              <a href={prev.href}>
                <span>← 上一条</span>
                <strong>{prev.title}</strong>
              </a>
            )}
            {next && (
              <a class="next" href={next.href}>
                <span>下一条 →</span>
                <strong>{next.title}</strong>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </PageShell>
</BaseLayout>

<style>
  .observation-detail {
    border-radius: var(--radius-lg);
    padding: clamp(1.3rem, 4vw, 2.4rem);
    background:
      radial-gradient(circle at top right, var(--accent-soft), transparent 18rem),
      rgba(255, 255, 255, 0.9);
    box-shadow: var(--shadow-card);
  }

  .accent-blue {
    --accent: var(--color-blue);
    --accent-soft: color-mix(in srgb, var(--color-blue) 16%, transparent);
  }

  .accent-pink {
    --accent: var(--color-pink);
    --accent-soft: color-mix(in srgb, var(--color-pink) 16%, transparent);
  }

  .accent-cyan {
    --accent: var(--color-cyan);
    --accent-soft: color-mix(in srgb, var(--color-cyan) 14%, transparent);
  }

  .accent-gold {
    --accent: var(--color-gold);
    --accent-soft: color-mix(in srgb, var(--color-gold) 16%, transparent);
  }

  header {
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 1.8rem;
    padding-bottom: 1.4rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .back {
    color: var(--color-muted);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  .back:hover {
    color: color-mix(in srgb, var(--color-blue) 70%, var(--color-ink));
  }

  .kind {
    border: 1px solid color-mix(in srgb, var(--accent) 46%, white);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    background: color-mix(in srgb, var(--accent) 14%, white);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0.7rem 0 0.5rem;
    color: var(--color-text);
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    line-height: 1.12;
  }

  .lede {
    margin: 0 0 1.2rem;
    color: var(--color-muted);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin: 0;
  }

  .facts div {
    display: grid;
    gap: 0.18rem;
  }

  .facts dt {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .facts dd {
    margin: 0;
    color: var(--color-text);
    font-size: 0.92rem;
    font-weight: 750;
  }

  .facts dd time {
    font-weight: 700;
  }

  .status {
    border-radius: 999px;
    padding: 0.14rem 0.5rem;
    background: color-mix(in srgb, var(--accent) 26%, white);
    font-size: 0.82rem;
  }

  .status-finished {
    background: color-mix(in srgb, var(--color-gold) 34%, white);
  }

  .status-dropped {
    background: rgba(190, 200, 214, 0.34);
    color: var(--color-muted);
  }

  .rating em {
    color: color-mix(in srgb, var(--color-ink) 86%, var(--color-blue));
    font-size: 1.3rem;
    font-style: normal;
    font-weight: 900;
  }

  .rating span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .ext {
    color: color-mix(in srgb, var(--color-blue) 62%, var(--color-ink));
    font-weight: 800;
    text-decoration: none;
  }

  .ext:hover {
    text-decoration: underline;
  }

  .prose {
    margin-bottom: 2rem;
  }

  .siblings {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .siblings li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed color-mix(in srgb, var(--color-line) 70%, transparent);
    padding-bottom: 0.4rem;
  }

  .siblings a {
    color: var(--color-text);
    font-size: 0.94rem;
    font-weight: 750;
    text-decoration: none;
  }

  .siblings a:hover {
    color: color-mix(in srgb, var(--color-blue) 70%, var(--color-ink));
  }

  .siblings span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 900;
  }

  .detail-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.85rem;
    margin-top: 2rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.4rem;
  }

  .detail-nav a {
    display: grid;
    gap: 0.3rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0.85rem 0.95rem;
    background: rgba(255, 255, 255, 0.84);
    color: var(--color-text);
    text-decoration: none;
  }

  .detail-nav a:hover {
    border-color: color-mix(in srgb, var(--color-blue) 55%, var(--color-line));
    box-shadow: var(--shadow-pop);
  }

  .detail-nav .next {
    text-align: right;
  }

  .detail-nav span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .detail-nav strong {
    font-size: 0.96rem;
    line-height: 1.4;
  }
</style>
