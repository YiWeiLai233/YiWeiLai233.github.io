---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageShell from '@/components/layout/PageShell.astro';
import Button from '@/components/ui/Button.astro';
import ArchiveFrame from '@/components/ui/ArchiveFrame.astro';
import MascotBubble from '@/components/ui/MascotBubble.astro';
import { site } from '@/data/site';

const shortcuts = site.nav.filter((item) => item.href !== '/');
---

<BaseLayout
  title="页面未找到 · 404"
  description="这条观测记录不存在，可能是链接过期或内容已迁移。"
  noindex
>
  <PageShell narrow>
    <article class="not-found anime-frame">
      <div class="code-row">
        <span class="code">404</span>
        <span class="badge">信号丢失 / SIGNAL LOST</span>
      </div>
      <h1>这条观测记录不存在</h1>
      <p>
        你请求的页面可能被移动、改名或从未存在。观测站的记录会持续更新，
        旧链接偶尔会失效——先从下面重新出发吧。
      </p>

      <div class="actions">
        <Button href="/">回到首页</Button>
        <Button href="/logs/" variant="secondary">翻开发日志</Button>
      </div>

      <ArchiveFrame label="快速导航">
        <ul class="shortcuts">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </ArchiveFrame>

      <div class="mascot">
        <MascotBubble>
          咦？这里什么都没有。要不要跟着我回观测站看看最近在做什么？
        </MascotBubble>
      </div>
    </article>
  </PageShell>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: 1.15rem;
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 4vw, 2.6rem);
  }

  .code-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .code {
    color: color-mix(in srgb, var(--color-blue) 72%, var(--color-ink));
    font-family: var(--font-mono);
    font-size: clamp(2.6rem, 9vw, 4.6rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .badge {
    border: 1px solid color-mix(in srgb, var(--color-pink) 52%, var(--color-line));
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    background: color-mix(in srgb, var(--color-pink) 16%, white);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1.5rem, 3.6vw, 2.2rem);
    line-height: 1.2;
  }

  p {
    max-width: 40rem;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.85;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .shortcuts {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shortcuts a {
    color: var(--color-text);
    font-weight: 800;
    text-decoration: none;
  }

  .shortcuts a:hover {
    color: color-mix(in srgb, var(--color-blue) 70%, var(--color-ink));
  }

  .mascot {
    max-width: 34rem;
  }
</style>
