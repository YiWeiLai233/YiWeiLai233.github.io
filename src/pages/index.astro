---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageShell from '@/components/layout/PageShell.astro';
import HeroSection from '@/components/feature/HeroSection.astro';
import ProjectCard from '@/components/feature/ProjectCard.astro';
import PostCard from '@/components/feature/PostCard.astro';
import SkillPanel from '@/components/feature/SkillPanel.astro';
import CollectionCorner from '@/components/feature/CollectionCorner.astro';
import MiniGuideCard from '@/components/feature/MiniGuideCard.astro';
import ChapterMascot from '@/components/feature/ChapterMascot.astro';
import ObservationCard from '@/components/feature/ObservationCard.astro';
import MascotTheater from '@/components/feature/MascotTheater.astro';
import ArchiveFrame from '@/components/ui/ArchiveFrame.astro';
import Button from '@/components/ui/Button.astro';
import { observationKinds, observationKindOrder } from '@/data/observations';
import {
  getEntrySlug,
  getObservationHref,
  getPostHref,
  getProjectHref,
  sortObservationsByDateDesc,
  sortPostsByDateDesc,
  sortProjectsByPriority
} from '@/lib/content';

const posts = sortPostsByDateDesc(await getCollection('posts', ({ data }) => !data.draft)).slice(0, 3);
// 首页与项目档案页共用同一套 featured 排序逻辑：首页展示全部精选项目，
// 不再截断，完整清单通过下方「查看全部项目」进入 /projects/。
const projects = sortProjectsByPriority(await getCollection('projects', ({ data }) => data.featured));
// 观测区展示最近记下的 3 条真实条目，而不是分类入口
const allObservations = sortObservationsByDateDesc(
  await getCollection('observations', ({ data }) => !data.draft)
);
const featuredObservations = allObservations.slice(0, 3);
const kindCounts = observationKindOrder
  .map((kind) => ({
    kind,
    label: observationKinds[kind].short,
    count: allObservations.filter((item) => item.data.kind === kind).length
  }))
  .filter((entry) => entry.count > 0);
---

<BaseLayout title="未来观测站 | 忆丶未来的二次元个人站">
  <HeroSection />
  <PageShell>
    <div class="home-grid">
      <div class="home-main">
        <section class="home-section">
          <ChapterMascot
            chapter="项目"
            title="项目档案"
            subtitle="记录项目目标、实现过程、技术栈与长期维护状态。"
            variant="projects"
          />
          <div class="project-grid">
            {
              projects.map((project) => (
                <div id={getEntrySlug(project.id)}>
                  <ProjectCard
                    title={project.data.title}
                    summary={project.data.summary}
                    status={project.data.status}
                    stack={project.data.stack}
                    href={getProjectHref(project)}
                    repo={project.data.repo}
                    demo={project.data.demo}
                  />
                </div>
              ))
            }
          </div>
          <div class="section-actions">
            <Button href="/projects/" variant="secondary">查看全部项目</Button>
          </div>
        </section>

        <section class="home-section">
          <ChapterMascot
            chapter="收藏"
            title="二次元观测区"
            subtitle="番剧、游戏、音乐和日常碎片的具体条目，每条都有独立页面记录评分与进度。"
            variant="home"
          />
          <div class="observation-grid">
            {
              featuredObservations.map((item) => (
                <ObservationCard
                  item={{
                    title: item.data.title,
                    summary: item.data.summary,
                    kind: item.data.kind,
                    status: item.data.status,
                    rating: item.data.rating,
                    date: item.data.date,
                    href: getObservationHref(item)
                  }}
                  compact
                />
              ))
            }
          </div>
          {kindCounts.length > 0 && (
            <div class="kind-tally">
              {kindCounts.map((entry) => (
                <a href={`/collections/#${entry.kind}`}>
                  {entry.label}
                  <span>{entry.count}</span>
                </a>
              ))}
            </div>
          )}
          <div class="section-actions">
            <Button href="/collections/" variant="secondary">进入观测收藏</Button>
          </div>
        </section>

        <section class="home-section">
          <ChapterMascot
            chapter="日志"
            title="开发日志"
            subtitle="沉淀技术选择、问题排查、迭代记录和阶段复盘。"
            variant="logs"
          />
          <div class="post-list">
            {
              posts.map((post) => (
                <PostCard
                  title={post.data.title}
                  summary={post.data.summary}
                  date={post.data.date}
                  tags={post.data.tags}
                  href={getPostHref(post)}
                />
              ))
            }
          </div>
        </section>

        <MascotTheater />
      </div>

      <aside class="home-side">
        <MiniGuideCard
          title="观测站指南"
          text="首页以主图建立站点氛围，项目、日志和收藏模块负责承载主要内容。"
        />
        <ArchiveFrame label="今日路线">
          <h3>今日查看路线</h3>
          <ol>
            <li>从项目档案看最近在做什么。</li>
            <li>翻一篇开发日志，记录一个技术判断。</li>
            <li>浏览观测收藏，整理一条兴趣记录。</li>
          </ol>
        </ArchiveFrame>
        <SkillPanel />
        <CollectionCorner total={allObservations.length} counts={kindCounts.map((entry) => ({ label: entry.label, count: entry.count }))} />
      </aside>
    </div>
  </PageShell>
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(18rem, 27vw, 21rem);
    gap: clamp(1.1rem, 2.2vw, 1.7rem);
    align-items: start;
    isolation: isolate;
  }

  .home-main,
  .home-side {
    display: grid;
    gap: 1.2rem;
    min-width: 0;
  }

  .home-section {
    border-radius: var(--radius-lg);
    padding: 1.25rem 0 0.45rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1rem;
  }

  .post-list {
    display: grid;
    gap: 0.85rem;
  }

  .observation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .observation-grid > :global(:nth-child(3)) {
    grid-column: 1 / -1;
  }

  .kind-tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .kind-tally a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid color-mix(in srgb, var(--color-blue) 42%, var(--color-line));
    border-radius: 999px;
    padding: 0.26rem 0.62rem;
    background: color-mix(in srgb, var(--color-blue) 9%, white);
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
  }

  .kind-tally a:hover {
    border-color: color-mix(in srgb, var(--color-pink) 58%, var(--color-line));
  }

  .kind-tally span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .section-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
  }

  .home-side {
    align-self: start;
  }

  .home-side h3 {
    margin: 0 0 0.8rem;
    color: var(--color-text);
  }

  .home-side ol {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.2rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  @media (max-width: 1040px) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .home-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .observation-grid {
      grid-template-columns: 1fr;
    }

    .observation-grid > :global(:nth-child(3)) {
      grid-column: auto;
    }

    .home-side {
      grid-template-columns: 1fr;
    }

    .section-actions {
      justify-content: stretch;
    }

    .section-actions :global(.button) {
      width: 100%;
    }
  }

  @media (min-width: 681px) and (max-width: 1040px) {
    .observation-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
