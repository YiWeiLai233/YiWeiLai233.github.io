---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getEntrySlug, getPostHref, getReadingTime, sortPostsByDateDesc } from '@/lib/content';
import { extractToc } from '@/lib/toc';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: { title: string; href: string; date: Date; label: string };
  next?: { title: string; href: string; date: Date; label: string };
}

export async function getStaticPaths() {
  const posts = sortPostsByDateDesc(await getCollection('posts', ({ data }) => !data.draft));

  return posts.map((post, index) => {
    // posts 已按日期倒序：前一条 = 更新的，后一条 = 更早的
    const newer = posts[index - 1];
    const older = posts[index + 1];

    return {
      params: { slug: getEntrySlug(post.id) },
      props: {
        post,
        prev: older && {
          title: older.data.title,
          href: getPostHref(older),
          date: older.data.date,
          label: '更早一篇'
        },
        next: newer && {
          title: newer.data.title,
          href: getPostHref(newer),
          date: newer.data.date,
          label: '更新一篇'
        }
      }
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await post.render();
const { minutes } = getReadingTime(post.body ?? '');
const toc = extractToc(post.body ?? '');

// 结构化数据：让搜索引擎识别这是一篇带作者与发布日期的技术文章
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  keywords: post.data.tags.join(', '),
  articleSection: post.data.category,
  inLanguage: 'zh-CN',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://yiweilai233.github.io/logs/${getEntrySlug(post.id)}/`
  },
  author: {
    '@type': 'Person',
    name: '忆丶未来',
    url: 'https://github.com/YiWeiLai233'
  }
};
---

<ContentLayout
  title={post.data.title}
  description={post.data.summary}
  date={post.data.date}
  category={post.data.category}
  tags={post.data.tags}
  readingMinutes={minutes}
  toc={toc}
  prev={prev}
  next={next}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Content />
</ContentLayout>
