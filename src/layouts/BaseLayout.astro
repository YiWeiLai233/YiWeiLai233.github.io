---
import '@/styles/global.css';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import QuestWidget from '@/components/islands/QuestWidget.vue';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.name,
  description = `${site.owner} 的项目档案、开发日志和二次元收藏。`
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <QuestWidget client:load />
  </body>
</html>
