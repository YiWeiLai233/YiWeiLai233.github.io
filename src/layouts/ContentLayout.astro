---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageShell from '@/components/layout/PageShell.astro';
import PostNavigation from '@/components/feature/PostNavigation.astro';
import TableOfContents from '@/components/feature/TableOfContents.astro';
import TagPill from '@/components/ui/TagPill.astro';
import { formatDateLong, getTagHref } from '@/lib/content';
import type { TocItem } from '@/lib/toc';

interface Props {
  title: string;
  description: string;
  date?: Date;
  label?: string;
  category?: string;
  tags?: string[];
  readingMinutes?: number;
  toc?: TocItem[];
  prev?: { title: string; href: string; date: Date; label: string };
  next?: { title: string; href: string; date: Date; label: string };
}

const {
  title,
  description,
  date,
  label = '日志条目',
  category,
  tags = [],
  readingMinutes,
  toc = [],
  prev,
  next
} = Astro.props;

const dateText = date ? formatDateLong(date) : '';
const hasAside = toc.length > 2;
---

<BaseLayout title={title} description={description} type="article">
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <PageShell narrow={!hasAside}>
    <article class="content-layout anime-frame">
      <header>
        <div class="meta-row">
          <span class="label">{label}</span>
          {category && <span class="category">{category}</span>}
        </div>
        <h1>{title}</h1>
        <div class="sub-meta">
          {dateText && <time datetime={date?.toISOString()}>{dateText}</time>}
          {readingMinutes && <span class="reading">约 {readingMinutes} 分钟读完</span>}
        </div>
        <p class="lede">{description}</p>
        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => (
                <a class="tag-link" href={getTagHref(tag)}>
                  <TagPill label={tag} />
                </a>
              ))}
            </div>
          )
        }
      </header>

      <div class:list={['body-grid', { 'with-aside': hasAside }]}>
        <div class="prose">
          <slot />
        </div>
        {
          hasAside && (
            <aside class="toc-side">
              <TableOfContents items={toc} />
            </aside>
          )
        }
      </div>

      <PostNavigation prev={prev} next={next} />
    </article>
  </PageShell>
</BaseLayout>

<style>
  .content-layout {
    border-radius: var(--radius-lg);
    padding: clamp(1.3rem, 4vw, 2.4rem);
  }

  header {
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .label {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .category {
    border: 1px solid color-mix(in srgb, var(--color-pink) 50%, var(--color-line));
    border-radius: 999px;
    padding: 0.16rem 0.55rem;
    background: color-mix(in srgb, var(--color-pink) 14%, white);
    color: var(--color-muted);
    font-size: 0.74rem;
    font-weight: 800;
  }

  h1 {
    margin: 0.65rem 0;
    color: var(--color-text);
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.08;
  }

  .sub-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .reading::before {
    content: '·';
    margin-right: 0.55rem;
  }

  .lede {
    max-width: 44rem;
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.95rem;
  }

  .tag-link {
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .tag-link:hover {
    transform: translateY(-1px);
  }

  .body-grid {
    display: grid;
    gap: clamp(1.2rem, 3vw, 2.2rem);
  }

  .body-grid.with-aside {
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 15rem);
    align-items: start;
  }

  .toc-side {
    position: sticky;
    top: 1.5rem;
    order: 2;
  }

  .prose {
    min-width: 0;
    color: var(--color-text);
    font-size: 1.02rem;
    line-height: 1.9;
  }

  .prose :global(h2) {
    margin-top: 2rem;
    color: var(--color-text);
    scroll-margin-top: 1.5rem;
  }

  .prose :global(h3) {
    scroll-margin-top: 1.5rem;
  }

  .prose :global(a) {
    color: color-mix(in srgb, var(--color-blue) 72%, var(--color-text));
    font-weight: 800;
  }

  .prose :global(code) {
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-blue) 12%, white);
    padding: 0.1rem 0.32rem;
  }

  @media (max-width: 960px) {
    .body-grid.with-aside {
      grid-template-columns: 1fr;
    }

    .toc-side {
      position: static;
      order: 0;
    }
  }
</style>
