---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a class:list={['button', `button-${variant}`]} href={href}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.05rem;
    border-radius: 14px;
    padding: 0.82rem 1.15rem;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .button::after {
    margin-left: 0.75rem;
    content: '>';
    font-family: var(--font-mono);
    font-weight: 900;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    border: 1px solid color-mix(in srgb, var(--color-ink) 70%, white);
    background: linear-gradient(135deg, var(--color-ink), color-mix(in srgb, var(--color-blue) 45%, var(--color-ink)));
    color: white;
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.82);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: color-mix(in srgb, var(--color-blue) 58%, var(--color-line));
    box-shadow: var(--shadow-card);
  }
</style>
