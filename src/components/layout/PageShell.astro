---
interface Props {
  narrow?: boolean;
}

const { narrow = false } = Astro.props;
---

<div class:list={['page-shell', narrow && 'page-shell-narrow']}>
  <slot />
</div>

<style>
  .page-shell {
    width: min(1180px, calc(100% - clamp(2rem, 5vw, 5rem)));
    margin: 0 auto;
    padding: clamp(1.4rem, 2.4vw, 2.2rem) 0 4rem;
  }

  .page-shell-narrow {
    width: min(780px, calc(100% - 2rem));
  }
</style>
