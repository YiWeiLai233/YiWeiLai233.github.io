---
import { site } from '@/data/site';

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/';
  }

  return pathname.startsWith(href);
};
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-dot"></span>
    <span>{site.name}</span>
  </a>
  <nav aria-label="主导航">
    {site.nav.map((item) => (
      <a class:list={[isActive(item.href) && 'active']} href={item.href}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0.8rem;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1120px, calc(100% - 2rem));
    margin: 1rem auto;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.7rem 0.85rem;
    background: color-mix(in srgb, var(--color-paper) 92%, white);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(16px);
  }

  .brand,
  nav a {
    color: var(--color-text);
    font-weight: 800;
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .brand-dot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--color-pink), var(--color-blue));
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-pink) 22%, transparent);
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    border-radius: 999px;
    padding: 0.45rem 0.75rem;
    color: var(--color-muted);
  }

  nav a.active,
  nav a:hover {
    background: color-mix(in srgb, var(--color-blue) 16%, white);
    color: var(--color-text);
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      border-radius: var(--radius-lg);
      flex-direction: column;
      gap: 0.7rem;
    }

    nav {
      flex-wrap: wrap;
    }
  }
</style>
