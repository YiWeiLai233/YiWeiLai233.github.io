---
import { site } from '@/data/site';

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/';
  }

  return pathname.startsWith(href);
};
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">
      <img src="/assets/mini-guide-sticker.webp" alt="" loading="eager" decoding="async" />
    </span>
    <span>{site.name}</span>
  </a>
  <nav aria-label="主导航">
    {site.nav.map((item) => (
      <a class:list={[isActive(item.href) && 'active']} href={item.href}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0.8rem;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1120px, calc(100% - 2rem));
    margin: 1rem auto;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 24px;
    padding: 0.62rem 0.72rem;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(16px);
  }

  .brand,
  nav a {
    color: var(--color-text);
    font-weight: 800;
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 999px;
    background:
      radial-gradient(circle at 45% 26%, rgba(255, 255, 255, 0.96), transparent 38%),
      linear-gradient(135deg, color-mix(in srgb, var(--color-blue) 20%, white), color-mix(in srgb, var(--color-cyan) 18%, white));
    box-shadow:
      inset 0 0 0 3px rgba(255, 255, 255, 0.48),
      0 8px 18px rgba(61, 103, 136, 0.14);
  }

  .brand-mark img {
    width: 115%;
    height: 115%;
    object-fit: cover;
    object-position: center 42%;
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    border-radius: 16px;
    padding: 0.48rem 0.78rem;
    color: var(--color-muted);
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  nav a.active,
  nav a:hover {
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      border-radius: var(--radius-lg);
      flex-direction: column;
      gap: 0.7rem;
    }

    nav {
      flex-wrap: wrap;
    }
  }
</style>
