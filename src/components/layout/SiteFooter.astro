---
import { site } from '@/data/site';

const year = new Date().getFullYear();

const links = [
  { href: '/projects/', label: '项目档案' },
  { href: '/logs/', label: '开发日志' },
  { href: '/tags/', label: '标签索引' },
  { href: '/collections/', label: '观测收藏' },
  { href: '/about/', label: '站点档案' },
  { href: '/rss.xml', label: 'RSS 订阅' }
];
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <span class="footer-name">{site.name} / {year}</span>
      <p>由 {site.owner} 整理维护，收纳项目、日志和二次元碎片。</p>
    </div>

    <nav class="footer-links" aria-label="页脚导航">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>

  <div class="footer-bottom">
    <span class="footer-meta">{site.github.replace('https://github.com/', 'github.com/')} · Astro 静态构建</span>
    <a class="footer-top" href="#top">回到顶部 ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    width: min(1120px, calc(100% - 2rem));
    margin: 3rem auto 2rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.4rem;
    color: var(--color-muted);
  }

  .footer-main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    max-width: 26rem;
  }

  .footer-name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  p {
    margin: 0.35rem 0 0;
    line-height: 1.7;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }

  .footer-links a {
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: color-mix(in srgb, var(--color-blue) 70%, var(--color-ink));
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1.2rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-line) 80%, white);
    padding-top: 0.9rem;
  }

  .footer-meta {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .footer-top {
    color: var(--color-text);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 680px) {
    .footer-main,
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
