---
import { formatDate, formatRating } from '@/lib/content';
import { observationKinds, type ObservationKind, type ObservationStatus } from '@/data/observations';

export interface ObservationCardData {
  title: string;
  summary: string;
  kind: ObservationKind;
  status: ObservationStatus;
  rating?: number;
  date: Date;
  link?: string;
  linkLabel?: string;
  href?: string;
}

interface Props {
  item: ObservationCardData;
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
const meta = observationKinds[item.kind];
const statusText = meta.statusLabels[item.status];
const ratingText = formatRating(item.rating);
const href = item.href ?? (item.linkLabel ? item.link : undefined);
const isExternal = !item.href && Boolean(item.link);
const Wrapper = href ? 'a' : 'div';
---

<Wrapper
  class:list={['observation-card', `accent-${meta.accent}`, compact && 'is-compact', Boolean(href) && 'is-link']}
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <div class="observation-art" aria-hidden="true">
    <img src={meta.image} alt="" loading="lazy" decoding="async" />
  </div>
  <div class="observation-copy">
    <div class="meta-row">
      <span>{meta.short}</span>
      <b class:list={['status', `status-${item.status}`]}>{statusText}</b>
    </div>
    <h3>{item.title}</h3>
    <p class="summary">{item.summary}</p>
    <div class="foot-row">
      {ratingText && <span class="rating"><em>{ratingText}</em>/10</span>}
      <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
      {item.href && <span class="enter">查看观测 →</span>}
    </div>
  </div>
</Wrapper>

<style>
  .observation-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 13.5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 20px;
    padding: 1rem;
    background:
      radial-gradient(circle at top right, var(--accent-soft), transparent 10rem),
      linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(238, 250, 255, 0.72));
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(14px);
    color: var(--color-text);
    text-decoration: none;
  }

  .observation-card::before {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 0.24rem;
    background: linear-gradient(90deg, var(--accent), rgba(255, 255, 255, 0));
    content: '';
  }

  a.observation-card {
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  a.observation-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 65%, white);
    box-shadow: var(--shadow-pop);
  }

  .accent-blue {
    --accent: color-mix(in srgb, var(--color-blue) 82%, white);
    --accent-soft: color-mix(in srgb, var(--color-blue) 22%, transparent);
  }

  .accent-pink {
    --accent: color-mix(in srgb, var(--color-pink) 84%, white);
    --accent-soft: color-mix(in srgb, var(--color-pink) 22%, transparent);
  }

  .accent-cyan {
    --accent: color-mix(in srgb, var(--color-cyan) 82%, white);
    --accent-soft: color-mix(in srgb, var(--color-cyan) 20%, transparent);
  }

  .accent-gold {
    --accent: color-mix(in srgb, var(--color-gold) 86%, white);
    --accent-soft: color-mix(in srgb, var(--color-gold) 22%, transparent);
  }

  .observation-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    padding-right: clamp(4.2rem, 20%, 6.2rem);
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .meta-row > span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
  }

  .status {
    border-radius: 999px;
    padding: 0.2rem 0.52rem;
    background: rgba(255, 255, 255, 0.78);
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .status-ongoing {
    background: color-mix(in srgb, var(--accent) 30%, white);
  }

  .status-finished {
    background: color-mix(in srgb, var(--color-gold) 34%, white);
  }

  .status-planned {
    background: rgba(255, 255, 255, 0.9);
  }

  .status-dropped {
    background: rgba(190, 200, 214, 0.34);
    color: var(--color-muted);
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    color: var(--color-text);
    font-size: 1.22rem;
    line-height: 1.25;
  }

  .summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    color: var(--color-muted);
    line-height: 1.62;
  }

  .foot-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: auto;
    padding-top: 0.3rem;
  }

  .rating {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .rating em {
    color: color-mix(in srgb, var(--color-ink) 88%, var(--color-blue));
    font-size: 1.02rem;
    font-style: normal;
    font-weight: 900;
  }

  time {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .enter {
    margin-left: auto;
    color: color-mix(in srgb, var(--color-blue) 62%, var(--color-ink));
    font-size: 0.78rem;
    font-weight: 850;
  }

  .observation-art {
    position: absolute;
    right: 0.85rem;
    bottom: 0.7rem;
    z-index: 0;
    width: clamp(5rem, 24%, 7.2rem);
    opacity: 0.34;
  }

  .observation-art::before {
    position: absolute;
    inset: auto 0 0;
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--accent-soft);
    content: '';
    filter: blur(18px);
  }

  .observation-art img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px rgba(61, 103, 136, 0.12));
  }

  .is-compact {
    min-height: 12rem;
  }

  .is-compact .observation-copy {
    padding-right: 4.4rem;
  }

  .is-compact .observation-art {
    right: 0.75rem;
    bottom: 0.65rem;
    width: 5.2rem;
    opacity: 0.24;
  }

  .is-compact .observation-art::before {
    inset: 18% 0 0;
  }

  @media (max-width: 720px) {
    .observation-copy {
      padding-right: 3.4rem;
    }

    .observation-art {
      width: 4.8rem;
      opacity: 0.22;
    }
  }
</style>
