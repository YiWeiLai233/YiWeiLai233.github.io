---
import { formatDate } from '@/lib/content';

interface Props {
  prev?: { title: string; href: string; date: Date; label: string };
  next?: { title: string; href: string; date: Date; label: string };
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="post-nav" aria-label="相邻日志">
      {prev && (
        <a class="post-nav-link prev" href={prev.href}>
          <span class="post-nav-label">← {prev.label}</span>
          <strong>{prev.title}</strong>
          <time datetime={prev.date.toISOString()}>{formatDate(prev.date)}</time>
        </a>
      )}
      {next && (
        <a class="post-nav-link next" href={next.href}>
          <span class="post-nav-label">{next.label} →</span>
          <strong>{next.title}</strong>
          <time datetime={next.date.toISOString()}>{formatDate(next.date)}</time>
        </a>
      )}
    </nav>
  )
}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.85rem;
    margin-top: 2.4rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
  }

  .post-nav-link {
    display: grid;
    gap: 0.35rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.82);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .post-nav-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-blue) 55%, var(--color-line));
    box-shadow: var(--shadow-pop);
  }

  .next {
    text-align: right;
  }

  .post-nav-label,
  time {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  strong {
    font-size: 1rem;
    line-height: 1.4;
  }
</style>
