---
import TagPill from '@/components/ui/TagPill.astro';

interface Props {
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  href: string;
}

const { title, summary, date, tags, href } = Astro.props;
const dateText = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' }).format(date);
---

<article class="post-card">
  <img class="card-sticker" src="/assets/chibi-write.png" alt="" loading="lazy" decoding="async" />
  <div class="entry-meta">
    <span>开发日志</span>
    <time datetime={date.toISOString()}>{dateText}</time>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  <div class="tags">
    {tags.map((tag) => <TagPill label={tag} />)}
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-left: 4px solid color-mix(in srgb, var(--color-blue) 70%, white);
    border-radius: 16px;
    padding: 1rem 1rem 1rem 1.1rem;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .post-card > :not(.card-sticker) {
    position: relative;
    z-index: 1;
  }

  .card-sticker {
    position: absolute;
    right: 0.7rem;
    bottom: 0.55rem;
    z-index: 0;
    width: 5.2rem;
    height: auto;
    opacity: 0.13;
    pointer-events: none;
  }

  .entry-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .entry-meta span,
  time {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    color: var(--color-text);
    font-size: 1.18rem;
    line-height: 1.28;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  p {
    color: var(--color-muted);
    line-height: 1.7;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  @media (max-width: 680px) {
    .card-sticker {
      width: 4.4rem;
      opacity: 0.1;
    }
  }
</style>
