---
interface Props {
  total?: number;
  counts?: { label: string; count: number }[];
}

const { total = 0, counts = [] } = Astro.props;
---

<aside class="collection-corner vn-frame">
  <span>收藏角落</span>
  <h3>观测收藏</h3>
  <p>番剧、游戏、音乐和日常碎片的具体条目，每条都有独立页面记录评分与进度。</p>
  {counts.length > 0 && (
    <div class="chips">
      {counts.map((entry) => (
        <b>
          {entry.label}
          <em>{entry.count}</em>
        </b>
      ))}
    </div>
  )}
  <a href="/collections/">进入观测收藏{total > 0 ? ` · ${total} 条` : ''}</a>
</aside>

<style>
  .collection-corner {
    border-radius: var(--radius-lg);
    padding: 1.2rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--color-cyan) 22%, transparent), transparent 12rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.82), color-mix(in srgb, var(--color-blue) 10%, white));
  }

  span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 0.55rem 0 0.55rem;
    color: var(--color-text);
  }

  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  b {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 999px;
    padding: 0.28rem 0.58rem;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-text);
    font-size: 0.8rem;
  }

  em {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 800;
  }

  a {
    display: inline-flex;
    width: fit-content;
    border: 1px solid color-mix(in srgb, var(--color-blue) 48%, white);
    border-radius: 999px;
    margin-top: 1rem;
    padding: 0.42rem 0.72rem;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 850;
    text-decoration: none;
  }
</style>
