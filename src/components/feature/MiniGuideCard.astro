---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = '小助手值班中',
  text = '需要时点左上角观测板，我会把当前路线收起来放在那里。'
} = Astro.props;
---

<aside class="mini-guide vn-frame">
  <img src="/assets/mini-guide-sticker.png" alt="Q 版站点小助手" loading="lazy" decoding="async" />
  <div>
    <span>小助手</span>
    <h3>{title}</h3>
    <p>{text}</p>
  </div>
</aside>

<style>
  .mini-guide {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: center;
    border-radius: var(--radius-lg);
    padding: 0.85rem;
    overflow: hidden;
  }

  img {
    display: block;
    width: 5rem;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-blue) 12%, white);
    object-fit: cover;
    box-shadow: 0 10px 24px rgba(61, 103, 136, 0.12);
  }

  span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    margin-top: 0.25rem;
    color: var(--color-text);
    font-size: 1rem;
  }

  p {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.55;
  }

  @media (max-width: 480px) {
    .mini-guide {
      grid-template-columns: 4.2rem minmax(0, 1fr);
    }

    img {
      width: 4.2rem;
    }
  }
</style>
