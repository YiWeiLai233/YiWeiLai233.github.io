---
import Button from '@/components/ui/Button.astro';
import MascotBubble from '@/components/ui/MascotBubble.astro';
import { site } from '@/data/site';
---

<section class="hero desk-grid">
  <div class="hero-copy">
    <p class="hero-label">Guide Menu / Developer Desk</p>
    <h1>{site.hero.title}</h1>
    <p class="subtitle">{site.hero.subtitle}</p>
    <div class="actions">
      <Button href="/projects/">项目档案</Button>
      <Button href="/logs/" variant="secondary">开发日志</Button>
    </div>
    <MascotBubble>我把最近的项目和日志都整理好了，先从这里开始吧。</MascotBubble>
  </div>
  <div class="hero-visual">
    <div class="screen-card">
      <span>STATUS</span>
      <strong>Building</strong>
      <small>Astro / Markdown / Anime UI</small>
    </div>
    <img src="/assets/mascot-guide.svg" alt="站点看板娘" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    align-items: center;
    gap: 2rem;
    width: min(1120px, calc(100% - 2rem));
    min-height: 70vh;
    margin: 0 auto;
    border: 1px solid color-mix(in srgb, var(--color-line) 72%, transparent);
    border-radius: 28px;
    padding: clamp(1.2rem, 4vw, 3rem);
    background-color: color-mix(in srgb, var(--color-paper) 78%, white);
    box-shadow: var(--shadow-soft);
  }

  .hero-label {
    width: fit-content;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    background: color-mix(in srgb, var(--color-pink) 18%, white);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 46rem;
    margin: 1rem 0;
    color: var(--color-text);
    font-size: clamp(2.35rem, 6vw, 5rem);
    line-height: 1.02;
  }

  .subtitle {
    max-width: 39rem;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.5rem 0;
  }

  .hero-visual {
    position: relative;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--color-blue) 16%, white), color-mix(in srgb, var(--color-pink) 18%, white));
    padding: 1rem;
    box-shadow: var(--shadow-soft);
  }

  .hero-visual img {
    display: block;
    width: 100%;
  }

  .screen-card {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: grid;
    gap: 0.18rem;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    padding: 0.7rem 0.8rem;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: var(--shadow-card);
  }

  .screen-card span,
  .screen-card small {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .screen-card strong {
    color: var(--color-text);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
