---
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';
---

<section class="hero" aria-label="站点看板娘主图">
  <img
    class="hero-image"
    src="/assets/hero-desk-guide.png"
    alt="未来观测站看板娘在清爽的观测站房间里"
    loading="eager"
    decoding="async"
  />
  <h1>{site.hero.title}</h1>
</section>
<section class="hero-entry">
  <p>{site.hero.subtitle}</p>
  <div class="actions">
    <Button href="/projects/">项目档案</Button>
    <Button href="/logs/" variant="secondary">开发日志</Button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: min(1180px, calc(100% - 2rem));
    aspect-ratio: 16 / 9;
    margin: 0 auto 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.74);
    border-radius: 30px;
    background: #f7fdff;
    box-shadow: var(--shadow-soft);
  }

  .hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .hero-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 22px;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(14px);
  }

  .hero-entry p {
    margin: 0;
    color: var(--color-muted);
    font-weight: 750;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  @media (max-width: 760px) {
    .hero {
      border-radius: 22px;
    }

    .hero-entry {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
