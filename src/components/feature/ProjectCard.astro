---
import TagPill from '@/components/ui/TagPill.astro';

interface Props {
  title: string;
  summary: string;
  status: 'planning' | 'building' | 'released';
  stack: string[];
  href: string;
}

const { title, summary, status, stack, href } = Astro.props;
const statusLabel = {
  planning: '构想中',
  building: '构建中',
  released: '已发布'
}[status];
---

<article class="project-card anime-frame">
  <div class="meta-row">
    <span class="file-label">Project File</span>
    <span class:list={['status', `status-${status}`]}>{statusLabel}</span>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  <div class="stack">
    {stack.map((item) => <TagPill label={item} />)}
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: grid;
    gap: 0.85rem;
    min-height: 15rem;
    border-radius: var(--radius-lg);
    padding: 1.15rem;
    overflow: hidden;
  }

  .project-card::after {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    color: color-mix(in srgb, var(--color-blue) 22%, transparent);
    content: 'FILE';
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .file-label,
  .status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .file-label {
    color: var(--color-muted);
  }

  .status {
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
  }

  .status-planning {
    background: color-mix(in srgb, var(--color-gold) 18%, white);
    color: #8a611e;
  }

  .status-building {
    background: color-mix(in srgb, var(--color-blue) 18%, white);
    color: #2d6690;
  }

  .status-released {
    background: color-mix(in srgb, var(--color-cyan) 18%, white);
    color: #277479;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    color: var(--color-text);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  p {
    color: var(--color-muted);
    line-height: 1.7;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }
</style>
