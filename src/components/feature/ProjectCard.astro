---
import TagPill from '@/components/ui/TagPill.astro';

interface Props {
  title: string;
  summary: string;
  status: 'planning' | 'building' | 'released';
  stack: string[];
  href: string;
  repo?: string;
  demo?: string;
}

const { title, summary, status, stack, href, repo, demo } = Astro.props;
const statusLabel = {
  planning: '构想中',
  building: '构建中',
  released: '已发布'
}[status];
---

<article class="project-card">
  <img class="card-sticker" src="/assets/chibi-folder.webp" alt="" loading="lazy" decoding="async" />
  <div class="meta-row">
    <span class="file-label">项目档案</span>
    <span class:list={['status', `status-${status}`]}>{statusLabel}</span>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  <div class="stack">
    {stack.map((item) => <TagPill label={item} />)}
  </div>
  {(repo || demo) && (
    <div class="project-links">
      {repo && <a href={repo} target="_blank" rel="noreferrer">GitHub</a>}
      {demo && <a href={demo} target="_blank" rel="noreferrer">在线演示</a>}
    </div>
  )}
</article>

<style>
  .project-card {
    position: relative;
    display: grid;
    gap: 0.85rem;
    min-height: 15rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 18px;
    padding: 1.15rem;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.94), rgba(240, 251, 255, 0.76)),
      linear-gradient(135deg, color-mix(in srgb, var(--color-blue) 16%, transparent), color-mix(in srgb, var(--color-cyan) 12%, transparent));
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .project-card::before {
    height: 3.4rem;
    margin: -1.15rem -1.15rem 0;
    content: '';
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-blue) 24%, white), color-mix(in srgb, var(--color-pink) 20%, white)),
      linear-gradient(90deg, rgba(255, 255, 255, 0.42) 1px, transparent 1px);
    background-size: auto, 18px 18px;
  }

  .project-card > :not(.card-sticker) {
    position: relative;
    z-index: 1;
  }

  .card-sticker {
    position: absolute;
    right: 0.75rem;
    bottom: 0.65rem;
    z-index: 0;
    width: min(6.2rem, 34%);
    height: auto;
    opacity: 0.16;
    pointer-events: none;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }

  .file-label,
  .status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .file-label {
    color: var(--color-muted);
  }

  .status {
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
    background: rgba(255, 255, 255, 0.72);
  }

  .status-planning {
    background: color-mix(in srgb, var(--color-gold) 18%, white);
    color: #8a611e;
  }

  .status-building {
    background: color-mix(in srgb, var(--color-blue) 18%, white);
    color: #2d6690;
  }

  .status-released {
    background: color-mix(in srgb, var(--color-cyan) 18%, white);
    color: #277479;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    color: var(--color-text);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  p {
    color: var(--color-muted);
    line-height: 1.7;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-links a {
    border: 1px solid color-mix(in srgb, var(--color-blue) 44%, white);
    border-radius: 999px;
    padding: 0.32rem 0.62rem;
    background: rgba(255, 255, 255, 0.66);
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 850;
  }

  @media (max-width: 680px) {
    .card-sticker {
      width: 4.8rem;
      opacity: 0.12;
    }
  }
</style>
