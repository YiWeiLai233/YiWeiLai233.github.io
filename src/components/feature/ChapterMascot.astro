---
import ChapterHeading from '@/components/ui/ChapterHeading.astro';

interface Props {
  chapter: string;
  title: string;
  subtitle?: string;
  variant: 'projects' | 'logs' | 'about' | 'home';
}

const { chapter, title, subtitle, variant } = Astro.props;

const mascot = {
  home: {
    src: '/assets/chibi-wave.webp',
    alt: '挥手欢迎的 Q 版站点小助手',
    note: '导览'
  },
  projects: {
    src: '/assets/chibi-folder.webp',
    alt: '抱着文件夹的 Q 版站点小助手',
    note: '档案'
  },
  logs: {
    src: '/assets/chibi-write.webp',
    alt: '正在写日志的 Q 版站点小助手',
    note: '写作'
  },
  about: {
    src: '/assets/chibi-wave.webp',
    alt: '介绍站点的 Q 版站点小助手',
    note: '说明'
  }
}[variant];
---

<div class:list={['chapter-mascot', `chapter-mascot-${variant}`]}>
  <ChapterHeading chapter={chapter} title={title} subtitle={subtitle} />
  <figure>
    <img src={mascot.src} alt={mascot.alt} loading="lazy" decoding="async" />
    <figcaption>{mascot.note}</figcaption>
  </figure>
</div>

<style>
  .chapter-mascot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(5.4rem, 12vw, 8rem);
    gap: 1rem;
    align-items: end;
    margin-bottom: 1.25rem;
  }

  .chapter-mascot :global(.chapter-heading) {
    margin-bottom: 0;
  }

  figure {
    position: relative;
    align-self: center;
    margin: 0;
    justify-self: end;
    width: 100%;
  }

  figure::before {
    position: absolute;
    inset: 18% 10% auto auto;
    width: 58%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-blue) 18%, transparent);
    content: '';
    filter: blur(18px);
  }

  img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 22px;
    background: rgba(248, 253, 255, 0.74);
    box-shadow: 0 14px 32px rgba(61, 103, 136, 0.1);
    transform: rotate(3deg);
  }

  .chapter-mascot-projects img {
    transform: rotate(-3deg);
  }

  .chapter-mascot-logs img {
    transform: rotate(2deg);
  }

  figcaption {
    position: absolute;
    right: 0.35rem;
    bottom: -0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 999px;
    padding: 0.16rem 0.45rem;
    background: rgba(255, 255, 255, 0.78);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  @media (max-width: 720px) {
    .chapter-mascot {
      grid-template-columns: minmax(0, 1fr) 5.1rem;
      gap: 0.75rem;
      align-items: center;
    }

    figcaption {
      display: none;
    }
  }

  @media (max-width: 430px) {
    .chapter-mascot {
      grid-template-columns: minmax(0, 1fr);
    }

    figure {
      width: 5.2rem;
      justify-self: start;
      margin-top: -0.45rem;
    }
  }
</style>
